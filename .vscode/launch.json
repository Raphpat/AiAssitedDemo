{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Launch Frontend",
			"type": "chrome",
			"request": "launch",
			"preLaunchTask": "npm: start",
			"url": "http://localhost:4200/",
			"webRoot": "${workspaceFolder}/frontend",
			"sourceMaps": true,
			"runtimeExecutable": "C:/Program Files/BraveSoftware/Brave-Browser/Application/brave.exe",
			"sourceMapPathOverrides": {
				"webpack:/*": "${webRoot}/*",
				"/./*": "${webRoot}/*",
				"/src/*": "${webRoot}/src/*",
				"/*": "*",
				"/./~/*": "${webRoot}/node_modules/*"
			},
			"userDataDir": false,
			"presentation": {
				"hidden": false,
				"group": "frontend",
				"order": 1
			}
		},
		{
			"type": "java",
			"name": "MathApplication",
			"request": "launch",
			"mainClass": "com.example.MathApplication",
			"projectName": "AiTest",
			"cwd": "${workspaceFolder}",
			"env": {
				"SPRING_PROFILES_ACTIVE": "local"
			},
			"vmArgs": "-Dserver.port=8080"
		}
	],
	"compounds": [
		{
			"name": "Launch Full Stack",
			"configurations": [
				"MathApplication",
				"Launch Frontend"
			]
		}
	]
}
